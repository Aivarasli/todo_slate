{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slate Tasks",
        "url": "index.html",
        "width": 360,
        "height": 560,
        "minWidth": 300,
        "minHeight": 56,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "quickadd",
        "title": "Quick add",
        "url": "index.html?view=quickadd",
        "width": 560,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
